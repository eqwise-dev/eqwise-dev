# Copy to swarm/models.env and fill in. models.env is in .gitignore and
# Claude Code is not allowed to read it (see .claude/settings.json).

# Claude (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Meta Muse Spark (Meta developer portal; public preview, US, waitlist).
# MUSE_MODEL is "<litellm-provider>/<model-id>". If Meta's endpoint speaks
# the OpenAI chat format, use "openai/<model-id from Meta's docs>".
MUSE_API_KEY=
MUSE_API_BASE=
MUSE_MODEL=

# Optional extra providers (also uncomment them in litellm_config.yaml)
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Spending cap in USD per day, across all models
EQWISE_DAILY_BUDGET_USD=5

# Models used by review_diff when the caller does not choose
EQWISE_REVIEW_MODELS=claude-sonnet,muse-spark
